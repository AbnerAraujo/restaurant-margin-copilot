# Copy to .env and fill in. .env itself is gitignored.

# Postgres (docker-compose.yml reads these; defaults match if unset)
POSTGRES_DB=margin_copilot
POSTGRES_USER=margin_copilot
POSTGRES_PASSWORD=margin_copilot
POSTGRES_PORT=5432

# Used by `migrate` (golang-migrate) and the Go backend to connect.
DATABASE_URL=postgres://margin_copilot:margin_copilot@localhost:5432/margin_copilot?sslmode=disable

# Anthropic Console API key (not the Claude Pro/Max subscription) — required
# for the ambiguity gate and explanation step (both Sonnet 5, since
# 2026-08-29 — see internal/llmclient/cost.go) and the paraphrase-match
# cache classifier (Haiku 4.5).
ANTHROPIC_API_KEY=
